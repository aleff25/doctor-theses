# Subject system clones — pinned by subjects/subjects.lock.json, not vendored
subjects/petclinic/
subjects/trainticket/
subjects/teastore/

# Generated data — provenance lives in each dir's README, contents are reproducible
data/raw/*
data/interim/*
data/processed/*
data/labels/*
!data/*/.gitkeep

# A label set's provenance note is documentation and is tracked; the labels
# themselves are regenerated by models/build_dataset.py. Re-including a file
# inside an ignored directory needs the directory re-included first, otherwise
# git never looks in it.
!data/labels/*/
data/labels/*/*
!data/labels/*/README.md

# Build
target/
build/
*.class
*.jar

# Python
*.egg-info/
build/
dist/
__pycache__/
.pytest_cache/
.venv/
venv/
*.pyc
.ipynb_checkpoints/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
