	keywords = {Complex networks; Computer aided engineering; Cost engineering; Decision trees; Design; Iterative methods; Learning algorithms; Model structures; Neural networks; Shape optimization; Structural optimization; Support vector machines; Support vector regression; Computational costs; Finite element simulations; Gaussian process regression; Hyper-parameter optimizations; Latin hypercube sampling; Machine learning algorithm (MLAs); Structure design optimization; Termination criteria; Learning systems},
