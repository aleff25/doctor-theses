	keywords = {Biomimetics; Computation theory; Elasticity; Feedback; Fuzzy control; Fuzzy systems; Auto-scaling; Basal ganglia; Cloud elasticities; Dynamic resource provisioning; Feedback controller; Switched controller; Controllers},
