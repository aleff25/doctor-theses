Title = {Liability and Trust Analysis Framework for Multi-Actor Dynamic
   Microservices},
Journal = {IEEE TRANSACTIONS ON NETWORK AND SERVICE MANAGEMENT},
Year = {2025},
Volume = {22},
Number = {1},
Pages = {58-71},
Month = {FEB},
Abstract = {Microservices architecture has become an increasingly common approach
   for building complex software systems. With the distributed nature of
   microservices, multiple actors can contribute to a service, hence
   affecting the dynamics of the environment and making the management of
   liabilities and trust more challenging. Service-Level Agreements (SLAs)
   are critical in that regard and any SLA violation or breach can result
   in significant financial damages. One major challenge is the lack of
   indicators to handle the liability and trust in such architectures. To
   address this issue, in this paper we propose a liability and trust
   analysis framework, namely the LASM Analysis Service (LAS), for
   multi-actor dynamic microservices that employs Machine Learning (ML)
   techniques.},
